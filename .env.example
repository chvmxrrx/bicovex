# Copy to .env.local for local testing, and add the same keys in Vercel:
# Project > Settings > Environment Variables.

# API key from resend.com > API Keys.
RESEND_API_KEY=

# Inbox that receives the requests. Never shown on the site.
# While CONTACT_FROM uses onboarding@resend.dev, this must be the email
# you signed up to Resend with.
CONTACT_TO=

# Sender. Leave empty to use Resend's test sender. Once you verify a domain
# in Resend, use something like: BICOVEX <contacto@tudominio.cl>
CONTACT_FROM=

# Cloudflare Turnstile (dash.cloudflare.com > Turnstile). Set both or neither.
# For local testing you can use Cloudflare's test keys, which always pass:
#   NEXT_SITE_KEY=1x00000000000000000000AA
#   SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_SITE_KEY=
SECRET_KEY=
